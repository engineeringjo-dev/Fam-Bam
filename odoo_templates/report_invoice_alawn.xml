<t t-name="alawn.report_invoice_alawn">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">
<t t-call="web.basic_layout">
<div class="page" dir="rtl" style="font-family:'Noto Naskh Arabic','Noto Sans Arabic','Segoe UI',Tahoma,sans-serif;font-size:12px;color:#1a1a1a;direction:rtl;text-align:right">
  <t t-set="days" t-value="['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر']"/>
  <t t-set="wd" t-value="['الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت','الأحد']"/>
  <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda z: z.display_type == 'product')"/>
  <t t-set="paid" t-value="o.amount_total - o.amount_residual"/>

  <table style="width:100%;border-collapse:collapse;margin-bottom:6px">
    <tr>
      <td style="border:0;width:27%;text-align:right;vertical-align:top">
        <div>هاتف :</div>
        <div><span style="direction:ltr;display:inline-block;white-space:nowrap">0799123618</span> - م.عمر</div>
        <div><span style="direction:ltr;display:inline-block;white-space:nowrap">0790177761</span> - هاتف المحل</div>
      </td>
      <td style="border:0;width:46%;text-align:center;vertical-align:middle">
        <div style="font-size:18px;font-weight:bold">محلات العون لمواد البناء</div>
      </td>
      <td style="border:0;width:27%;text-align:left;vertical-align:top">
        <div style="font-weight:bold" t-out="wd[datetime.date.today().weekday()]"/>
        <div style="direction:ltr;text-align:left" t-out="datetime.date.today().strftime('%d/%m/%Y')"/>
      </td>
    </tr>
  </table>
  <div style="border-bottom:2px solid #333;margin-bottom:8px"/>

  <h2 style="text-align:center;font-size:19px;margin:6px 0">فاتورة</h2>
  <div style="text-align:center;font-size:14px;font-weight:bold;margin-bottom:2px" t-out="o.partner_id.name"/>
  <div style="text-align:center;margin-bottom:10px">
    <span t-out="o.name"/>
    <span> · </span>
    <span style="direction:ltr;display:inline-block">
      <span t-out="o.invoice_date.day"/><span> </span><span t-out="days[o.invoice_date.month-1]"/><span> </span><span t-out="o.invoice_date.year"/>
    </span>
  </div>

  <table style="width:100%;border-collapse:collapse;font-size:11.5px">
    <thead>
      <tr style="background:#eee">
        <th style="border:1px solid #999;padding:4px;width:6%;text-align:center;font-weight:bold">#</th>
        <th style="border:1px solid #999;padding:4px;text-align:center;font-weight:bold">الصنف</th>
        <th style="border:1px solid #999;padding:4px;width:12%;text-align:center;font-weight:bold">الكمية</th>
        <th style="border:1px solid #999;padding:4px;width:16%;text-align:center;font-weight:bold">الإجمالي</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="lines" t-as="l">
        <tr>
          <td style="border:1px solid #999;padding:3px;text-align:center;direction:ltr" t-out="l_index + 1"/>
          <td style="border:1px solid #999;padding:3px" t-out="' '.join((l.name or '').split())"/>
          <td style="border:1px solid #999;padding:3px;text-align:center;direction:ltr" t-out="'%g' % l.quantity"/>
          <td style="border:1px solid #999;padding:3px;text-align:center;direction:ltr" t-out="'%.3f' % l.price_subtotal"/>
        </tr>
      </t>
    </tbody>
  </table>

  <table style="width:52%;border-collapse:collapse;margin-top:10px;margin-right:auto;font-size:12.5px">
    <tr>
      <td style="border:1px solid #999;padding:5px;text-align:right">الإجمالي</td>
      <td style="border:1px solid #999;padding:5px;text-align:center;direction:ltr;width:40%" t-out="'%.3f' % o.amount_total"/>
    </tr>
    <t t-if="paid &gt; 0.0005">
      <tr style="background:#eef7ee">
        <td style="border:1px solid #999;padding:5px;text-align:right">المدفوع</td>
        <td style="border:1px solid #999;padding:5px;text-align:center;direction:ltr" t-out="'-%.3f' % paid"/>
      </tr>
      <tr style="background:#f2f2f2;font-weight:bold;font-size:14px">
        <td style="border:1px solid #999;padding:5px;text-align:right">المبلغ المستحق</td>
        <td style="border:1px solid #999;padding:5px;text-align:center;direction:ltr" t-out="'%.3f' % o.amount_residual"/>
      </tr>
    </t>
  </table>
</div>
</t>
</t>
</t>
</t>
