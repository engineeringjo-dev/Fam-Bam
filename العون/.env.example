# Copy to .env and fill in. Never commit the real .env.

# Your Odoo server and database.
ODOO_URL=https://alawn.odoo.com
ODOO_DB=alawn

# The user the API acts as, and an API key from that user's profile:
# My Profile > Account Security > New API Key.
# An API key reuses your existing user - it does not consume another seat.
ODOO_USERNAME=you@example.com
ODOO_API_KEY=

# Optional.
# ODOO_LANG=ar_001         # force a language for translated fields
# ODOO_ALLOW_WRITE=1       # create/update/business methods (default: on)
# ODOO_ALLOW_DELETE=0      # permanent deletion (default: off)
# ODOO_DEFAULT_LIMIT=80    # rows returned when no limit is given
# ODOO_MAX_LIMIT=1000      # hard cap on rows per call
# ODOO_TIMEOUT=30          # seconds per request
