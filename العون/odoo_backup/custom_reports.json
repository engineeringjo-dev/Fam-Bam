[
 {
  "id": 822,
  "name": "فاتورة (محلات العون)",
  "report_name": "alawn.report_invoice_alawn",
  "model": "account.move",
  "paperformat_id": [
   9,
   "كشف حساب العون A4"
  ],
  "print_report_name": "'فاتورة %s - %s %d %s %d' % (object.name, object.partner_id.name, object.invoice_date.day, ['كانون الثاني','شباط','آذار','نيسان','أيار','حزيران','تموز','آب','أيلول','تشرين الأول','تشرين الثاني','كانون الأول'][object.invoice_date.month-1], object.invoice_date.year)",
  "binding_model_id": [
   462,
   "Journal Entry"
  ],
  "binding_type": "report",
  "templates": [
   {
    "id": 2055,
    "name": "فاتورة العون",
    "key": "alawn.report_invoice_alawn",
    "type": "qweb",
    "arch_db": "<t t-name=\"alawn.report_invoice_alawn\">\n<t t-call=\"web.html_container\">\n<t t-foreach=\"docs\" t-as=\"o\">\n<t t-call=\"web.basic_layout\">\n<div class=\"page\" dir=\"rtl\" style=\"font-family:'Noto Naskh Arabic','Noto Sans Arabic','Segoe UI',Tahoma,sans-serif;font-size:12px;color:#1a1a1a;direction:rtl;text-align:right\">\n  <t t-set=\"days\" t-value=\"['كانون الثاني','شباط','آذار','نيسان','أيار','حزيران','تموز','آب','أيلول','تشرين الأول','تشرين الثاني','كانون الأول']\"/>\n  <t t-set=\"wd\" t-value=\"['الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت','الأحد']\"/>\n  <t t-set=\"lines\" t-value=\"o.invoice_line_ids.filtered(lambda z: z.display_type in ('line_note', 'line_section') or (z.display_type == 'product' and z.price_subtotal &gt;= 0)).sorted(lambda z: (z.sequence, z.id))\"/>\n  <t t-set=\"deds\" t-value=\"o.invoice_line_ids.filtered(lambda z: z.display_type == 'product' and z.price_subtotal &lt; 0)\"/>\n  <t t-set=\"paid\" t-value=\"o.amount_total - o.amount_residual\"/>\n  <t t-set=\"rls\" t-value=\"o.line_ids.filtered(lambda z: z.account_id.account_type == 'asset_receivable')\"/>\n  <t t-set=\"parts\" t-value=\"rls.mapped('matched_credit_ids').sorted(lambda z: (z.credit_move_id.date, z.id))\"/>\n  <t t-set=\"donp\" t-value=\"parts.filtered(lambda z: 'تبرع' in (z.credit_move_id.name or '').replace('ّ', ''))\"/>\n  <t t-set=\"oth\" t-value=\"parts - donp\"/>\n  <t t-set=\"donpaid\" t-value=\"sum(donp.mapped('amount'))\"/>\n  <t t-set=\"othpaid\" t-value=\"paid - donpaid\"/>\n  <t t-set=\"othlisted\" t-value=\"sum(oth.mapped('amount'))\"/>\n  <t t-set=\"gross\" t-value=\"o.amount_total - sum(deds.mapped('price_subtotal'))\"/>\n  <t t-set=\"special\" t-value=\"bool(deds) or bool(donp)\"/>\n  <t t-set=\"items\" t-value=\"o.invoice_line_ids.filtered(lambda z: z.display_type == 'product' and z.price_subtotal &gt;= 0)\"/>\n  <t t-set=\"donitems\" t-value=\"['(%d) %s' % (i + 1, ' '.join((z.name or '').replace('(تبرّع من فاعل خير)', '').split('] ')[-1].split())) for i, z in enumerate(items) if 'فاعل خير' in (z.name or '')]\"/>\n\n  <table style=\"width:100%;border-collapse:collapse;margin-bottom:6px\">\n    <tr>\n      <td style=\"border:0;width:27%;text-align:right;vertical-align:top\">\n        <div>هاتف :</div>\n        <div><span style=\"direction:ltr;display:inline-block;white-space:nowrap\">0799123618</span> - م.عمر</div>\n        <div><span style=\"direction:ltr;display:inline-block;white-space:nowrap\">0790177761</span> - هاتف المحل</div>\n      </td>\n      <td style=\"border:0;width:46%;text-align:center;vertical-align:middle\">\n        <div style=\"font-size:18px;font-weight:bold\">محلات العون لمواد البناء</div>\n      </td>\n      <td style=\"border:0;width:27%;text-align:left;vertical-align:top\">\n        <div style=\"font-weight:bold\" t-out=\"wd[datetime.date.today().weekday()]\"/>\n        <div style=\"direction:ltr;text-align:left\" t-out=\"datetime.date.today().strftime('%d/%m/%Y')\"/>\n      </td>\n    </tr>\n  </table>\n  <div style=\"border-bottom:2px solid #333;margin-bottom:8px\"/>\n\n  <h2 style=\"text-align:center;font-size:19px;margin:6px 0\">فاتورة</h2>\n  <div style=\"text-align:center;font-size:14px;font-weight:bold;margin-bottom:2px\" t-out=\"o.partner_id.name\"/>\n  <div style=\"text-align:center;margin-bottom:10px\">\n    <span>رقم ( </span><span style=\"direction:ltr;display:inline-block\" t-out=\"o.name\"/><span> )</span>\n    <span> · </span>\n    <span>تاريخ ( </span>\n    <span style=\"direction:rtl;display:inline-block\">\n      <span t-out=\"o.invoice_date.day\"/><span> </span><span t-out=\"days[o.invoice_date.month-1]\"/><span> </span><span t-out=\"o.invoice_date.year\"/>\n    </span>\n    <span> )</span>\n  </div>\n\n  <table style=\"width:100%;border-collapse:collapse;font-size:11.5px\">\n    <thead>\n      <tr style=\"background:#eee\">\n        <th style=\"border:1px solid #999;padding:4px;width:6%;text-align:center;font-weight:bold\">#</th>\n        <th style=\"border:1px solid #999;padding:4px;text-align:center;font-weight:bold\">الصنف</th>\n        <th style=\"border:1px solid #999;padding:4px;width:12%;text-align:center;font-weight:bold\">الكمية</th>\n        <th style=\"border:1px solid #999;padding:4px;width:16%;text-align:center;font-weight:bold\">الإجمالي</th>\n      </tr>\n    </thead>\n    <tbody>\n      <t t-set=\"n\" t-value=\"0\"/>\n      <t t-foreach=\"lines\" t-as=\"l\">\n        <tr t-if=\"l.display_type == 'product'\">\n          <t t-set=\"n\" t-value=\"n + 1\"/>\n          <td style=\"border:1px solid #999;padding:3px;text-align:center;direction:ltr\" t-out=\"n\"/>\n          <td style=\"border:1px solid #999;padding:3px\" t-out=\"' '.join((l.name or '').split())\"/>\n          <td style=\"border:1px solid #999;padding:3px;text-align:center;direction:ltr\" t-out=\"'%g' % l.quantity\"/>\n          <td style=\"border:1px solid #999;padding:3px;text-align:center;direction:ltr\" t-out=\"'%.3f' % l.price_subtotal\"/>\n        </tr>\n        <tr t-if=\"l.display_type == 'line_section'\" style=\"background:#f2f2f2;font-weight:bold\">\n          <td colspan=\"4\" style=\"border:1px solid #999;padding:3px\" t-out=\"' '.join((l.name or '').split())\"/>\n        </tr>\n        <tr t-if=\"l.display_type == 'line_note'\" style=\"background:#fbfbf3\">\n          <td style=\"border:1px solid #999;padding:3px\"/>\n          <td colspan=\"3\" style=\"border:1px solid #999;padding:3px;font-size:10.5px;color:#555\" t-out=\"' '.join((l.name or '').split())\"/>\n        </tr>\n      </t>\n    </tbody>\n  </table>\n\n  <table style=\"width:70%;border-collapse:collapse;margin-top:10px;margin-right:auto;font-size:12.5px\">\n    <tr>\n      <td style=\"border:1px solid #999;padding:5px;text-align:right\">الإجمالي</td>\n      <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr;width:32%\" t-out=\"'%.3f' % gross\"/>\n    </tr>\n\n    <t t-if=\"special\">\n      <t t-foreach=\"donp\" t-as=\"p\">\n        <tr style=\"background:#eef7ee\">\n          <td style=\"border:1px solid #999;padding:5px;text-align:right\">\n            <div>\n              <span>تبرّع (فاعل خير)</span>\n              <t t-if=\"donitems\"><span> — بند </span><span t-out=\"' و '.join(donitems)\"/></t>\n              <t t-if=\"not donitems\"><span> — </span><span t-out=\"' '.join((p.credit_move_id.name or '').split())\"/></t>\n            </div>\n            <div style=\"font-size:10.5px;color:#666;direction:ltr;text-align:right\" t-out=\"p.credit_move_id.date.strftime('%d/%m/%Y')\"/>\n          </td>\n          <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'-%.3f' % p.amount\"/>\n        </tr>\n      </t>\n      <t t-foreach=\"deds\" t-as=\"d\">\n        <tr style=\"background:#fdf8e0\">\n          <td style=\"border:1px solid #999;padding:5px;text-align:right\">\n            <div t-out=\"' '.join((d.name or '').split())\"/>\n            <div style=\"font-size:10.5px;color:#666;direction:ltr;text-align:right\" t-out=\"o.invoice_date.strftime('%d/%m/%Y')\"/>\n          </td>\n          <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'%.3f' % d.price_subtotal\"/>\n        </tr>\n      </t>\n      <tr style=\"background:#f2f2f2;font-weight:bold\">\n        <td style=\"border:1px solid #999;padding:5px;text-align:right\">الإجمالي المستحق (الصافي)</td>\n        <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'%.3f' % (o.amount_total - donpaid)\"/>\n      </tr>\n    </t>\n\n    <t t-if=\"othpaid &gt; 0.0005\">\n      <t t-foreach=\"oth\" t-as=\"p\">\n        <tr style=\"background:#eef7ee\">\n          <td style=\"border:1px solid #999;padding:5px;text-align:right\">\n            <span>مدفوع</span>\n            <t t-if=\"p.credit_move_id.name\"><span> — </span><span t-out=\"' '.join(p.credit_move_id.name.split())\"/></t>\n            <span style=\"color:#666\"> · </span>\n            <span style=\"direction:ltr;display:inline-block;color:#666\" t-out=\"p.credit_move_id.date.strftime('%d/%m/%Y')\"/>\n          </td>\n          <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'-%.3f' % p.amount\"/>\n        </tr>\n      </t>\n      <tr t-if=\"othpaid - othlisted &gt; 0.0005\" style=\"background:#eef7ee\">\n        <td style=\"border:1px solid #999;padding:5px;text-align:right\">مدفوع</td>\n        <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'-%.3f' % (othpaid - othlisted)\"/>\n      </tr>\n    </t>\n\n    <tr t-if=\"othpaid &gt; 0.0005\" style=\"background:#f2f2f2;font-weight:bold;font-size:14px\">\n      <td style=\"border:1px solid #999;padding:5px;text-align:right\">المبلغ المستحق</td>\n      <td style=\"border:1px solid #999;padding:5px;text-align:center;direction:ltr\" t-out=\"'%.3f' % o.amount_residual\"/>\n    </tr>\n  </table>\n</div>\n  <div class=\"footer\" style=\"text-align:center;font-size:10px;color:#666;direction:rtl;font-family:'Noto Naskh Arabic','Noto Sans Arabic','Segoe UI',Tahoma,sans-serif\">\n    <span>صفحة </span><span class=\"page\"/><span> من </span><span class=\"topage\"/>\n  </div>\n</t>\n</t>\n</t>\n</t>",
    "active": true
   }
  ]
 },
